# Exemplu de configurare (copiaza in .env sau seteaza in environment).
# NICIUN secret nu e in cod.

US_HOST=0.0.0.0
US_PORT=8000
US_DATA_DIR=./data

# Admin de bootstrap (prima pornire). Daca parola e goala, se genereaza una
# random si se scrie in data/bootstrap_password.txt. Se cere schimbarea la primul login.
US_BOOTSTRAP_ADMIN=admin
# US_BOOTSTRAP_PASSWORD=

# Inrolare agenti:
#  - in productie: enrollment token per-dispozitiv (din consola).
#  - tranzitoriu (agentii Python v3 existenti): cheie partajata legacy.
US_LEGACY_AGENT_KEY=
US_ALLOW_LEGACY_KEY=1

# Sesiuni admin (secunde), rate limiting login, prag offline.
US_SESSION_TTL=43200
US_LOGIN_MAX_FAILS=8
US_LOGIN_LOCK=300
US_OFFLINE_AFTER=30
